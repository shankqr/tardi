{
	"name": "frontend",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy:dev": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=tardi --branch=dev --commit-dirty=true",
		"deploy:prod": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=tardi --branch=main --commit-dirty=true"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.0",
		"smol-toml": "^1.6.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.68.1"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.43.0",
		"@sentry/vite-plugin": "^5.1.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"firebase": "^12.9.0"
	}
}
