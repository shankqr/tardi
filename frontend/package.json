{
	"name": "frontend",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"engines": {
		"node": ">=22.12 <23 || >=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy:dev": "WRANGLER_ENV=preview npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=tardi --branch=dev --commit-dirty=true",
		"deploy:prod": "WRANGLER_ENV=production npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=tardi --branch=main --commit-dirty=true",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:cleanup": "tsx e2e/scripts/cleanup.ts",
		"test:e2e:setup": "playwright test --project=setup"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"dotenv": "^17.3.1",
		"firebase-admin": "^13.7.0",
		"jsdom": "^29.0.1",
		"smol-toml": "^1.6.0",
		"stripe": "^20.4.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.1",
		"wrangler": "^4.68.1"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.43.0",
		"@sentry/vite-plugin": "^5.1.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-web-links": "^0.11.0",
		"@xterm/xterm": "^5.5.0",
		"firebase": "^12.9.0"
	}
}
