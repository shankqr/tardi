# Firebase (same across environments)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mock mode: set to 'true' to bypass Firebase auth and backend API
# Remove or set to 'false' once Firebase credentials are configured
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK=true

# Feature flags
VITE_FF_MODEL_SELECTION=false
VITE_FF_HEALTH_CHECK=false
VITE_FF_GOOGLE_WORKSPACE=false

# Runtime variables (set in Cloudflare Pages dashboard: Settings > Environment Variables)
# These are read server-side via platform.env, NOT baked in at build time.
# COMING_SOON=true
# API_URL=https://api.tardi.com
