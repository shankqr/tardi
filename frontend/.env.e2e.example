# E2E Test Configuration
# Copy to .env.e2e and fill in values

# Target environment
E2E_BASE_URL=https://dev.tardi-467.pages.dev
E2E_API_URL=https://tardi-api-dev-867058695579.europe-west1.run.app

# Test user password (same for all generated test users)
E2E_TEST_PASSWORD=

# Firebase Admin SDK (for creating/verifying/deleting test users)
FIREBASE_PROJECT_ID=tardi-dev-488420
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client API key (public, from wrangler.toml)
FIREBASE_API_KEY=

# Stripe test secret key (for creating subscriptions and cleanup)
STRIPE_SECRET_KEY=

# Agent configuration test credentials
E2E_OPENROUTER_API_KEY=
